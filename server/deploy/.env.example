# Copy to .env; generate separate strong passwords. Never commit .env.
POSTGRES_ADMIN_PASSWORD=
DATABASE_PASSWORD=
PUBLIC_URL=https://treasury.example.com
PORT=8080
TREASURY_ENV=production
CORS_ORIGINS=
TRUSTED_PROXY_ADDRESSES=

# Each enabled provider needs BOTH credentials and its exact registered callback URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Configure email to enable verification and account recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=starttls
